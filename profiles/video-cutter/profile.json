{
  "$schema": "../profile.schema.json",
  "id": "video-cutter",
  "name": "Video-Cutter",
  "kind": "vite-spa",
  "siteUrl": "https://kodinitools.com/video-cutter/",
  "languages": ["de", "en"],
  "repo": {
    "dir": "/opt/kodini/sites/video-cutter",
    "branch": "main",
    "remote": "origin"
  },
  "webroot": "/var/www/kodinitools.com",
  "content": {
    "dir": "src/content",
    "files": {
      "site": "site.json"
    },
    "commitPaths": ["src/content/site.json"]
  },
  "uploads": {
    "dir": "{webroot}/uploads",
    "urlPrefix": "/uploads"
  },
  "build": {
    "command": ["npm", "run", "build"],
    "env": {
      "VITE_API_BASE": "/video-cutter",
      "VITE_FFMPEG_CORE_URL": "/video-cutter/ffmpeg"
    },
    "timeoutMinutes": 15
  },
  "preview": {
    "base": "/designer/preview/",
    "outDir": "dist-preview",
    "env": {
      "base": "VITE_BASE",
      "outDir": "VITE_OUT_DIR"
    }
  },
  "deploy": {
    "command": ["bash", "deploy/deploy.sh"],
    "env": {
      "SKIP_API": "1",
      "BASE_PATH": "/video-cutter/",
      "WEB_ROOT": "/var/www/kodinitools.com/video-cutter"
    },
    "timeoutMinutes": 20
  },
  "codeUpdate": {
    "enabled": true
  },
  "tabs": ["fields"],
  "fields": {
    "file": "site",
    "langs": ["de", "en"],
    "preview": {
      "file": "preview.html",
      "vars": {
        "--vc-accent": "theme.accent",
        "--vc-playhead": "theme.playhead",
        "--vc-bg": {
          "light": "theme.light.bg",
          "dark": "theme.dark.bg"
        },
        "--vc-surface": {
          "light": "theme.light.surface",
          "dark": "theme.dark.surface"
        },
        "--vc-text": {
          "light": "theme.light.text",
          "dark": "theme.dark.text"
        },
        "--vc-bg-image": {
          "path": "theme.bgImage",
          "kind": "image"
        },
        "--vc-bg-image-opacity": {
          "path": "theme.bgImageOpacity",
          "kind": "number"
        },
        "--vc-bg-image-darken": {
          "path": "theme.bgImageDarken",
          "kind": "number"
        },
        "--vc-bg-image-blur": {
          "path": "theme.bgImageBlur",
          "kind": "number"
        }
      }
    },
    "slots": [
      {
        "key": "app.title",
        "label": "Titel der App",
        "type": "text",
        "textPath": "texts.{lang}.app.title",
        "stylePath": "styles.app.title",
        "placeholder": {
          "de": "Video schneiden",
          "en": "Cut video"
        },
        "defaultSize": 20
      },
      {
        "key": "app.subtitle",
        "label": "Untertitel",
        "type": "text",
        "textPath": "texts.{lang}.app.subtitle",
        "stylePath": "styles.app.subtitle",
        "placeholder": {
          "de": "Videos schnell und einfach schneiden.",
          "en": "Cut videos quickly and easily."
        },
        "defaultSize": 13
      },
      {
        "key": "drop.title",
        "label": "Ablagefläche – Titel",
        "type": "text",
        "textPath": "texts.{lang}.drop.title",
        "stylePath": "styles.drop.title",
        "placeholder": {
          "de": "Video hierher ziehen oder klicken",
          "en": "Drop a video here or click"
        },
        "defaultSize": 16
      },
      {
        "key": "drop.hint",
        "label": "Ablagefläche – Hinweis",
        "type": "textarea",
        "textPath": "texts.{lang}.drop.hint",
        "stylePath": "styles.drop.hint",
        "placeholder": {
          "de": "MP4, WebM, MOV … Die Datei wird zum Schneiden auf den Server geladen.",
          "en": "MP4, WebM, MOV … The file is uploaded to the server for cutting."
        },
        "defaultSize": 14
      },
      {
        "key": "footer",
        "label": "Fußzeile",
        "type": "text",
        "textPath": "texts.{lang}.footer",
        "stylePath": "styles.footer",
        "placeholder": {
          "de": "Serverseitige Verarbeitung mit FFmpeg.",
          "en": "Server-side processing with FFmpeg."
        },
        "defaultSize": 12
      }
    ],
    "groups": [
      {
        "title": "Seite (Titel & Meta)",
        "fields": [
          {
            "path": "meta.title",
            "type": "text",
            "label": "Seitentitel (Browser-Tab)",
            "placeholder": "Video schneiden – KodiniTools"
          },
          {
            "path": "meta.description",
            "type": "textarea",
            "label": "Meta-Beschreibung",
            "placeholder": "Videos schnell und einfach schneiden – KodiniTools."
          }
        ]
      },
      {
        "title": "Farben der App",
        "fields": [
          {
            "path": "theme.accent",
            "type": "color",
            "label": "Akzentfarbe (Logo, Buttons, Auswahl)",
            "placeholder": "#4f8cff"
          },
          {
            "path": "theme.playhead",
            "type": "color",
            "label": "Abspielposition (Playhead)",
            "placeholder": "#ffd24a"
          },
          {
            "path": "theme.light.bg",
            "type": "color",
            "label": "Hell – Hintergrund",
            "placeholder": "#f6f7f9"
          },
          {
            "path": "theme.light.surface",
            "type": "color",
            "label": "Hell – Fläche",
            "placeholder": "#ffffff"
          },
          {
            "path": "theme.light.text",
            "type": "color",
            "label": "Hell – Text",
            "placeholder": "#1a1f26"
          },
          {
            "path": "theme.dark.bg",
            "type": "color",
            "label": "Dunkel – Hintergrund",
            "placeholder": "#0e1116"
          },
          {
            "path": "theme.dark.surface",
            "type": "color",
            "label": "Dunkel – Fläche",
            "placeholder": "#161b22"
          },
          {
            "path": "theme.dark.text",
            "type": "color",
            "label": "Dunkel – Text",
            "placeholder": "#e6edf3"
          }
        ]
      },
      {
        "title": "Hintergrundbild der App",
        "fields": [
          {
            "path": "theme.bgImage",
            "type": "image",
            "label": "Hintergrundbild",
            "hint": "Empfehlung: 1920×1080 px, WebP, unter 300 KB. Liegt fest hinter der gesamten App (beide Farbschemata)."
          },
          {
            "path": "theme.bgImageOpacity",
            "type": "number",
            "label": "Deckkraft (%)",
            "min": 0,
            "max": 100,
            "step": 1,
            "placeholder": "100"
          },
          {
            "path": "theme.bgImageDarken",
            "type": "number",
            "label": "Abdunkeln (%)",
            "min": 0,
            "max": 100,
            "step": 1,
            "placeholder": "0"
          },
          {
            "path": "theme.bgImageBlur",
            "type": "number",
            "label": "Weichzeichner (px)",
            "min": 0,
            "max": 40,
            "step": 1,
            "placeholder": "0"
          }
        ]
      }
    ]
  }
}
