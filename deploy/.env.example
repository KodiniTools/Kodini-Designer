# Vorlage für /opt/kodini/.env (Server, chmod 600, NICHT ins Git committen).
# Wird von der systemd-Unit kodini-designer.service via EnvironmentFile geladen.

# --- Site-Profil ---
# Ordnername unter profiles/ (Default: kodinitools-home). Alternativ
# PROFILE_FILE=/pfad/zu/profile.json für ein Profil außerhalb des Repos.
PROFILE=kodinitools-home

# --- Netzwerk ---
PORT=9020

# --- Auth (ein Inhaber-Konto) ---
# Passwort-Hash erzeugen:  node server/hash-password.mjs 'DEIN-PASSWORT'
ADMIN_PASSWORD_HASH=

# Zufälliges Secret zum Signieren der Session-Cookies (z. B. `openssl rand -hex 32`)
SESSION_SECRET=

# Cookie-Pfad. Produktion (Admin unter /admin): Default /admin passt — leer lassen.
# Nur für lokale Tests, wenn der Dienst direkt unter / läuft: COOKIE_PATH=/
# COOKIE_PATH=/admin

# --- Pfade (optional: überstimmen das Profil) ---
# REPO_DIR=/opt/kodini/repo
# WEBROOT=/var/www/kodinitools.com
# UPLOADS_DIR=/var/www/kodinitools.com/uploads

# --- Git (optional: überstimmen das Profil) ---
# GIT_BRANCH=main
# GIT_REMOTE=origin

# --- Upload-Limits ---
MAX_UPLOAD_MB=2048
