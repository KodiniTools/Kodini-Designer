# Vorlage für /opt/kodini/designer.env (Server, chmod 600, NICHT ins Git).
# Wird NACH /opt/kodini/.env geladen und überstimmt deren Werte – so teilen sich
# kodini-admin und kodini-designer Secrets und Pfade, laufen aber getrennt.

# Site-Profile (Ordnernamen unter profiles/, Kommaliste). Das erste ist der
# Standard; bei mehreren erscheint ein Umschalter in der Kopfzeile.
PROFILES=kodinitools-home

# Eigener Port (kodini-admin belegt 9020)
PORT=9030

# nginx-Präfix des Designers (Session-Cookie gilt nur dort)
COOKIE_PATH=/designer

# Eigene Ordner, damit sich Designer und Admin nicht in die Quere kommen:
# Vorgangs-Status (Vorschau/Veröffentlichung) und Vorschau-Build. Je Profil
# entsteht darin automatisch ein Unterordner <profil-id>.
STATE_DIR=/opt/kodini/designer-state
PREVIEW_DIR=/opt/kodini/designer-preview
# Öffentlicher Pfad der Vorschau (= nginx-Präfix + /preview/)
PREVIEW_BASE=/designer/preview/

# Zentraler Ordner mit eigenen Schriften (.woff2/.woff/.ttf/.otf) – wird in allen
# Profilen zur Schriftwahl angeboten (zusätzlich zu fonts.dirs des Profils).
# Die Dateien müssen unter <site>/fonts/<datei> auch von der jeweiligen Website
# ausgeliefert werden (bei kodinitools.com: genau dieser Ordner).
FONTS_DIR=/var/www/kodinitools.com/fonts
