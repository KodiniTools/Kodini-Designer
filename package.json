{
  "name": "kodini-designer",
  "version": "0.1.0",
  "private": true,
  "description": "Eigenständiger Website-Designer/Admin mit Site-Profilen (Node, ohne Laufzeit-Abhängigkeiten)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
